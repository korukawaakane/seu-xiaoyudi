# Public site URL for canonical URLs, Open Graph, robots, and sitemap.
NEXT_PUBLIC_SITE_URL=https://example.vercel.app

# CloudBase environment ID used for public document database reads.
NEXT_PUBLIC_CLOUDBASE_ENV_ID=

# CloudBase environment ID used by the local content import script.
CLOUDBASE_ENV_ID=

# Local-only Tencent Cloud credentials for the import script. Do not expose them to the browser.
TENCENTCLOUD_SECRETID=
TENCENTCLOUD_SECRETKEY=
TENCENTCLOUD_SESSIONTOKEN=
